# Copy to .env. Everything here is optional — the four static detection
# layers run fully offline with no provider configured.
#
# A provider only enables differential screening (layer 5), which scores
# the raw and sanitized document with the same prompt to prove whether
# concealed content actually changes the outcome.
#
# Set ANY ONE of the keys below. Calls go through LiteLLM, so the choice
# of provider changes nothing downstream. First key found wins, in the
# order listed here.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# TOGETHERAI_API_KEY=

# Override the auto-selected model. Takes precedence over every key above,
# and accepts any LiteLLM model id — including local models, which need no
# key at all:
#   RESUMESHIELD_SCREENER_MODEL=ollama/llama3.2
#   RESUMESHIELD_SCREENER_MODEL=gpt-4o-mini
#   RESUMESHIELD_SCREENER_MODEL=gemini/gemini-2.0-flash
# RESUMESHIELD_SCREENER_MODEL=

# Comma-separated CORS origins. Defaults to localhost dev ports.
# RESUMESHIELD_ALLOWED_ORIGINS=https://your-frontend.example.com
