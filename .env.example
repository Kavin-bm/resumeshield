# Copy to .env. Everything here is optional — the scanner's four static
# detection layers run fully offline with no key configured.

# Enables differential screening (layer 5): scores the raw and sanitized
# document with the same prompt to prove whether concealed content
# actually changes the outcome.
ANTHROPIC_API_KEY=

# Model used for that screening comparison.
RESUMESHIELD_SCREENER_MODEL=claude-haiku-4-5-20251001

# Comma-separated CORS origins. Defaults to localhost dev ports.
# RESUMESHIELD_ALLOWED_ORIGINS=https://your-frontend.example.com
